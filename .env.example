# UClone-X environment configuration template.
# Copy to `.env` and fill in what you use; every value below is optional.

# --- Foundation model API keys -------------------------------------------
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Local models (no API key required) ----------------------------------
# Two tiers so cheap turn loops and deep reasoning can use different models.
OLLAMA_FAST_BASE_URL="http://localhost:11434/v1"
OLLAMA_FAST_MODEL="qwen3:1.7b"
OLLAMA_INDEPTH_BASE_URL="http://localhost:11434/v1"
OLLAMA_INDEPTH_MODEL="qwen3:8b"

# A vLLM server is started per model on a port chosen at launch, so both of these
# are required and neither is guessed for you: `VLLM_MODEL` must be the exact string
# `vllm serve` was given. `VLLM_API_KEY` only if you put a gateway in front.
VLLM_BASE_URL=""
VLLM_MODEL=""
VLLM_API_KEY=""

# --- OpenTelemetry and tracing -------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="http://localhost:3001"
